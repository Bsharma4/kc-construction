# Form backend that accepts a JSON POST (Formspree, serverless function, CRM webhook, ...)
# Leave empty to keep the quote form in clearly-labelled demo mode.
VITE_FORM_ENDPOINT=

# Business phone shown on every "Call Now for a Bid" button (tap-to-call).
# Leave empty until the real number is confirmed — buttons then open the bid form.
VITE_PHONE_NUMBER=
